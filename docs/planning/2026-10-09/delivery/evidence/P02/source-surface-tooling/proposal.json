  "sourceReviewNotes": {
    "docs/reviews/open.mjs": {
      "howWhereWhy": "Delegates open/status/stop/restart to the common-Git-directory manager, isolates Git redirect environment, validates canonical build/artifact paths, reports reused older built versions, and stops its own server on signals. This prevents duplicate review servers across worktrees.",
      "componentBoundary": "REPO-10 document review tooling; not the product dashboard or P06."
    },
    "docs/reviews/src/features/local-review.mjs": {
      "howWhereWhy": "Adds separate manager-token health/stop routes, counts and drains active handler promises, and supplies injected notes-lock acquisition for existing save/share controls. Host/origin checks, page-token gates, identity/revision/path bounds and note-only branch-safe sharing remain. Draining prevents lock release while writes or Git sharing are unfinished.",
      "httpMethods": {
        "/": "GET",
        "/api/session": "GET",
        "/api/identity": "POST",
        "/api/notes": "POST",
        "/api/share": "POST",
        "/_review/health": "GET",
        "/_review/stop": "POST"
      },
      "evidenceLimit": "No new runtime execution. Existing server-lifecycle summary reports57 passing native Windows tests; record hashes bind this source, but its full raw suite output is not supplied by that summary."
    },
    "docs/reviews/src/features/notes-controller.mjs": {
      "howWhereWhy": "A live document version relabel now says its repository save is pending. The standalone unload warning defers to attachLocalReview, whose actual notes-local sequence/sharing warning was inspected; it tracks pending writes even when browser storage is unavailable. Offline export/storage behavior remains.",
      "evidenceLimit": "The server-lifecycle record does not individually hash this module. This current source review binds its bytes; existing passing suite claims are not a new test run."
    },
    "docs/reviews/src/features/review-server.mjs": {
      "howWhereWhy": "Uses an OS-owned notes lifetime lock in the shared Git directory, private authenticated state and persisted loopback port. Reuse requires a matching live protocol/token/instance/checkout/document; unresponsive lock owners stay unknown. Shutdown closes/drains its exact server before state removal and unlock; recorded PIDs are never killed.",
      "limits": [
        "Native POSIX and simultaneous Windows/WSL ownership are explicitly unqualified in existing evidence.",
        "Shutdown may wait for unfinished handlers; there is no forced takeover."
      ]
    },
    "tests/platform/native_go.py": {
      "howWhereWhy": "Collects exact native foundation package evidence from immutable copied source. Checks pinned toolchain/module/checksums, actual host/compiler/SDK, ten test-bearing packages, separate exact Darwin image/host selections and CGO0 refusal. Bounded owned preparation/test process sessions are stopped/reaped on timeout or interruption, with atomic checkpoints and closed test-event/exit/source-drift admission.",
      "limits": [
        "Collector controls are synthetic, not native execution.",
        "Normal Darwin runtime selection remains exact fail-closed control only.",
        "Separate installed-image/lifecycle evidence is not real protected four-role boot, actual Compose, WSL or phase acceptance."
      ],
      "externalUrlLiterals": [
        "https://go.dev/dl/?mode=json&include=all",
        "https://go.dev/dl/",
        "https://proxy.golang.org"
      ],
      "dependencyInspection": "Actual fixed tests/contracts/ci.py downloader import, not an arbitrary provider command.",
      "httpPathExplanation": "No HTTP handler routes. Bare slash expressions are module/path manipulation; Go/proxy URLs are external collector dependencies."
    }
