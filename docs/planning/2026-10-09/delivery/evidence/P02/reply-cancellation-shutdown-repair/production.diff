+// Each recorded error is a snapshot from this reply boundary. Cancellation is
+// shutdown only; it does not confirm that Flush completed or a caller accepted a reply.
+func ownerBridgeReplyOutcome(lifetime context.Context, beforePublish, publishErr, flushErr, afterFlush, bootErr error) error {
+	if authority := ownerBridgeRecordedAuthorityError(beforePublish); authority != nil {
+		return authority
+	}
+	if beforePublish != nil || publishErr != nil {
+		return bridgeError("reply_failed")
+	}
+	if authority := ownerBridgeRecordedAuthorityError(afterFlush); authority != nil {
+		return authority
+	}
+	if flushErr != nil && !(errors.Is(flushErr, context.Canceled) && lifetime.Err() == context.Canceled) {
+		return bridgeError("reply_failed")
+	}
+	if bootErr != nil {
+		return bridgeError("startup_failed")
+	}
+	return nil
