  "sourceReviewNotes": {
    "platform/deployment/local_tls_material.go": {
      "howWhereWhy": "Enrolls one P256 profile CA/90-day DNS server leaf, discards the CA signing key, admits exact live chain/key/name/shape, copies explicit getters, and redacts default/nonstring formatting and JSON. Explicit enrollment only; no warm renewal or network-derived trust.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/local_tls_probe_transport.go": {
      "howWhereWhy": "For admitted local trust, returns actual concrete pinned TLS1.3-first dialer before NATS INFO/CONNECT and rejects endpoint mismatch/discovery. Nil trust is explicit historical raw transport only; installed callers must reject it before credentials.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/owner_bridge_config.go": {
      "howWhereWhy": "Adds separate HOST account to existing factory output, with distinct host/client passwords and fixed scope-derived owner request/reply permissions only. Scope correlation grants no kernel, business, account or storage permission.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/probe_cleanup.go": {
      "howWhereWhy": "Existing concrete localtls cleanup retains its exact dialer and logical cause; narrow new raw branch retains the actual raw owner through the same failure result. Probe/Observe callers clear facts on failed cleanup; primary cause stays in fixed-safe typed errors.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/secure_compose.go": {
      "howWhereWhy": "Adds exact enrolled server certificate/key as fixed root0400 inline configs alongside existing private broker config. No CA signing key; profile/material/TLS config are validated. Output remains private and requires exact caller Docker/config binding.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/secure_local_config.go": {
      "howWhereWhy": "Builds only from existing trusted factories then adds one exact TLS1.3 handshake-first block. Duplicate JSON keys, case-aliased TLS, trailing data and excess depth/size are rejected; output still contains private passwords and widens no account grants.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_connection.go": {
      "howWhereWhy": "Explicit remote/team TLS1.2-compatible roots/DNS and actual broker authentication/server identity, scoped one-frame kernel observation and optional account INFO. No writes, broker start, storage provisioning or federation claim. New owned raw cleanup runs before SDK close/key wipe, clears all result facts on failure and retains retry ownership.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials.go": {
      "howWhereWhy": "Private host policy binds dedicated credential reference and full organization/project/kernel scope outside workspaces. Closed bounded document read transfers fresh Basic or JWT material; returned JWT signing key must be wiped after owned connection cleanup. No provider-auth discovery.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials_unix.go": {
      "howWhereWhy": "Repaired reader keeps every actual no-follow directory fd until return, pre-I/O caps the held directory walk128, checks UID/mode/PublicAncestor initially/finally and final private root/file PrivateObject. Link count, size, content/time/inode, canonical containment checks remain. No path reopening, fd duplication or authority-by-name.",
      "buildConstraint": "linux || darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials_unsupported.go": {
      "howWhereWhy": "Non-Linux/non-Darwin team secret reads refuse with fixed platform-unqualified result; no permissive fallback.",
      "buildConstraint": "!linux && !darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/kernel/protocol/server_trust.go": {
      "howWhereWhy": "Closed bounded trust artifact binds exact full role scope and endpoint; immutable ClientTrust checks explicit CA/DNS/leaf pin. This validates trusted declarations, not a network peer authority claim.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/kernel/protocol/server_trust_darwin.go": {
      "howWhereWhy": "Darwin Ctimespec accessor preserves native file-change identity; ACL/mount/cgo admission remains shared privatefs responsibility.",
      "buildConstraint": "darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/kernel/protocol/server_trust_linux.go": {
      "howWhereWhy": "Linux ctime accessor participates in same-file read identity; it is not a permission or qualification decision.",
      "buildConstraint": "linux",
      "ownerSource": "current component-inventory.json"
    },
    "platform/kernel/protocol/server_trust_unix.go": {
      "howWhereWhy": "Opens/retains every actual no-follow ancestor and private file descriptor, applies shared privatefs policy, and verifies owner/mode/nlink/size/time/change/inode before returning bounded bytes. No credentials or trust accepted from another OS owner.",
      "buildConstraint": "linux || darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/kernel/protocol/server_trust_unsupported.go": {
      "howWhereWhy": "Other platforms refuse private server trust reading with a fixed unqualified error.",
      "buildConstraint": "!linux && !darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/localtls/client.go": {
      "howWhereWhy": "Immutable explicit local loopback CA/DNS/exact leaf trust; fixed TLS1.3 handshake before NATS credentials. Dialer owns only sockets it opens, rejects other networks/endpoints/discovered servers, keeps failed closes for exact retry and joins owned calls/cancellation hooks. No system roots or secret keys.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/privatefs/access.go": {
      "howWhereWhy": "Descriptor-only policy supplements, rather than replaces, caller UID/mode/path/nlink/content checks. RawConn.Control holds the actual descriptor during native admission; no path/principal discovery or authority grant.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/privatefs/access_darwin.go": {
      "howWhereWhy": "Actual native FD requires local ownership-enforced mount and valid extended ACL. PrivateObject refuses every ALLOW; PublicAncestor refuses mutation ALLOW; DENY entries remain allowed. Cgo/Apple behavior still needs actual native execution.",
      "buildConstraint": "darwin && cgo",
      "ownerSource": "current component-inventory.json"
    },
    "platform/privatefs/access_darwin_nocgo.go": {
      "howWhereWhy": "Darwin without cgo refuses descriptor qualification; compilation is not usable private-store qualification.",
      "buildConstraint": "darwin && !cgo",
      "ownerSource": "current component-inventory.json"
    },
    "platform/privatefs/access_linux.go": {
      "howWhereWhy": "Linux relies on caller0600/0700 POSIX ACL masking plus actual valid descriptor checks; it does not weaken existing owner/mode policies.",
      "buildConstraint": "linux",
      "ownerSource": "current component-inventory.json"
    },
    "platform/privatefs/access_unsupported.go": {
      "howWhereWhy": "Other platforms refuse descriptor qualification with a fixed error.",
      "buildConstraint": "!linux && !darwin",
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials_privatefs_linux_test.go": {
      "howWhereWhy": "Linux held regular object positive, wrong ancestor kind and missing/closed descriptor negatives. Actual affected existing credential and connection suites remain required.",
      "buildConstraint": "linux",
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials_privatefs_darwin_test.go": {
      "howWhereWhy": "Native source fixture changes ACLs only on freshly created current-owner home objects; file/root read grants, ancestor write grants, persistent mid-read directory/ancestor grants are refused; DENY-only positive. No sudo or existing installation edits. Native execution remains open.",
      "buildConstraint": "darwin && cgo",
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/team_credentials_privatefs_darwin_nocgo_test.go": {
      "howWhereWhy": "Exact separate native Darwin!cgo refusal declaration; current ARM64 build is crosscompile only. The collector owner separately adds exact native selection, not a qualification claim here.",
      "buildConstraint": "darwin && !cgo",
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/raw_transport_cleanup.go": {
      "howWhereWhy": "Fixed typed raw cleanup error retains only actual dialer pointer/cause, redacts pointer/value Format/JSON, and supports bounded Close(ctx) retry without socket adoption or lifetime extension.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/raw_transport_cleanup_test.go": {
      "howWhereWhy": "Actual TCP sockets minted by the raw dialer exercise owner/SDK/cancel close failure retention, physical retry EOF, safe formatting, held gate deadlines and actual controlled blocked-hook bounded joins. Test-only embedded Conn wrapper; no production injection API.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    },
    "platform/deployment/observe.go": {
      "howWhereWhy": "Raw dialer wrappers retain actual sockets/hooks and report observed cleanup failures even after later successful physical close. Fixed1s initial cleanup join and bounded retry gates/active Dial/hook joins avoid new waiter goroutines. Existing read-only Observe clears facts when raw cleanup fails; concrete localtls path remains unchanged.",
      "buildConstraint": null,
      "ownerSource": "current component-inventory.json"
    }
  },
