      ],
      "status": "not-run"
    },
    {
      "id": "FAIL-56",
      "scenario": "Two terminals or WSL sessions start together; startup owner crashes mid-boot",
      "oracle": "One startup owner and one selected instance; waiting callers receive bounded progress or failure. Stale ownership recovery cannot create duplicate stacks or trust an unrelated PID.",
      "phases": [
        "P02",
        "P06",
        "P12"
      ],
      "status": "not-run"
    },
    {
      "id": "FAIL-57",
      "scenario": "Docker or Compose absent, daemon unavailable, permission denied or image pull fails",
