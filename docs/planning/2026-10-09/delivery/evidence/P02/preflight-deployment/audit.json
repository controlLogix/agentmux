    {
      "id": "FAIL-55",
      "scenario": "Cold launch with no selected instance, then warm launch from another project directory",
      "oracle": "One owned Compose project reaches actual service and application readiness; the next launch reuses its identity and volumes unchanged. Both display the same scoped status schema.",
