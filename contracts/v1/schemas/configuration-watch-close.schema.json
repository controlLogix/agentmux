{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:configuration-watch-close",
  "description": "Host-signed cleanup of one original configuration watch. It only cancels and joins that allocation. An optional signed joined response confirms receipt so the owner can retire its completed record after the original request expires. This control grants no read authority and is not an ordinary operation envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-configuration-watch-close-v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$",
          "minLength": 72,
          "maxLength": 72
        },
        "watchRequestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "cancellationRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "owner": {
          "$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"
        },
        "configurationRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "replySubject": {
          "type": "string",
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,64}\\.[a-f0-9]{64}$",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f\u2028\u2029]"
          }
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "joinedResponseBytes": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "not": {
            "pattern": "\\s"
          }
        }
      },
      "required": [
        "purpose",
        "requestId",
        "watchRequestDigest",
        "operationId",
        "cancellationRef",
        "owner",
        "configurationRef",
        "profileId",
        "hubId",
        "authorityId",
        "signingKeyRef",
        "replySubject",
        "issuedAt",
        "expiresAt"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
