{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:configuration-watch-close-response",
  "description": "Service-signed proof of cleanup for the exact original watch and close request. joined proves that original work and response delivery have joined. receiptConfirmed acknowledges a host-signed receipt containing an earlier joined proof. No configuration data or read authority is returned.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-configuration-watch-close-response-v1"
        },
        "requestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$",
          "minLength": 72,
          "maxLength": 72
        },
        "watchRequestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "cancellationRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "owner": {
          "$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"
        },
        "configurationRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "replySubject": {
          "type": "string",
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,64}\\.[a-f0-9]{64}$",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f\u2028\u2029]"
          }
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "requestSigningKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "requestPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "minLength": 43,
          "maxLength": 43
        },
        "watchExpiresAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "authorityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "joined": {
          "type": "boolean"
        },
        "receiptConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "purpose",
        "requestId",
        "watchRequestDigest",
        "operationId",
        "cancellationRef",
        "owner",
        "configurationRef",
        "profileId",
        "hubId",
        "authorityId",
        "replySubject",
        "requestDigest",
        "requestSigningKeyRef",
        "requestPublicKey",
        "watchExpiresAt",
        "signingKeyRef",
        "authorityRef",
        "issuedAt",
        "validUntil",
        "joined",
        "receiptConfirmed"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "receiptConfirmed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "joined": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
