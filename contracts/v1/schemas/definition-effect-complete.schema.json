{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:definition-effect-complete",
  "title": "definition-effect-complete v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "definitionId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "scope": {
      "enum": [
        "repo",
        "global"
      ]
    },
    "originalOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "originalPayloadDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "effectId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "attemptOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    }
  },
  "required": [
    "definitionId",
    "name",
    "scope",
    "originalOperationId",
    "originalPayloadDigest",
    "effectId",
    "attemptOperationId"
  ]
}
