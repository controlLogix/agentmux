{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:application-discovery-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-application-discovery-request-v1"
        },
        "requestId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "instanceId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "releaseDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "policyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "workspaceRef": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "transportRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "grantRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "replySubject": {
          "type": "string",
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,128}(?:\\.[A-Za-z0-9_-]{1,128})?$",
          "maxLength": 264
        }
      },
      "required": [
        "purpose",
        "requestId",
        "nonce",
        "authorityId",
        "hubId",
        "profileId",
        "instanceId",
        "releaseDigest",
        "policyRef",
        "workspaceRef",
        "transportRef",
        "grantRef",
        "issuedAt",
        "expiresAt",
        "replySubject"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
