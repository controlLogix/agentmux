{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:configuration-state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "amx-configuration-v1"
    },
    "owner": {
      "$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "configurationBytes": {
      "type": "string",
      "maxLength": 21848,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "secretReferences": {
      "type": "array",
      "items": {
        "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "configurationChecksum": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "revision": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/revision"
    }
  },
  "required": [
    "format",
    "owner",
    "schemaRef",
    "configurationBytes",
    "secretReferences",
    "configurationChecksum",
    "revision"
  ]
}
