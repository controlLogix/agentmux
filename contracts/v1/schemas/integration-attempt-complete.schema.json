{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:integration-attempt-complete",
  "title": "Agentmux integration-attempt-complete v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effectRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "originalOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "originalPayloadDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "attemptOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    }
  },
  "required": [
