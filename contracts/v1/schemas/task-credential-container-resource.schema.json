{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:task-credential-container-resource",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agentmux-task-container-v1"
    },
    "runRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "bindingDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "engineId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "containerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "runRef",
    "bindingDigest",
    "engineId",
    "imageId",
    "containerId"
  ]
}
