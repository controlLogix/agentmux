{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:federation-code-index",
  "title": "federation-code-index v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envelope": {
          "type": "object"
        },
        "subject": {
          "type": "string",
          "pattern": "^am\\.code\\.[a-z0-9_]{1,32}\\.r[a-f0-9]{12}$"
        },
        "localNode": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,32}$"
        }
      },
      "required": [
        "envelope",
        "subject",
        "localNode"
      ]
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "resourceRef",
    "input",
    "attribution"
  ]
}
