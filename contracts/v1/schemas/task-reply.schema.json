{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:task-reply",
  "description": "A current task service signs the exact original request, reply destination, retained record and enrolled source. A reservation receipt is not delivery, execution or receiver acceptance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-task-response-v1"
        },
        "responseContractId": {
          "const": "task-reply"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "serviceIdentityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "serviceInstanceId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "requestContractId": {
          "enum": [
            "task-inspect",
            "task-reserve"
          ]
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "payloadDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "replySubject": {
          "type": "string",
          "maxLength": 264,
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,128}(?:\\.[A-Za-z0-9_-]{1,128})?$"
        },
        "outcome": {
          "enum": [
            "record",
            "committed"
          ]
        },
        "taskRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "recordRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bindingDigest": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
            },
            "streamCreated": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
            }
          },
          "required": [
            "bindingDigest",
            "streamCreated"
          ]
        },
        "recordBytes": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "replayed": {
          "type": "boolean"
        },
        "authorityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        }
      },
      "required": [
        "purpose",
        "responseContractId",
        "profileId",
        "hubId",
        "authorityId",
        "serviceIdentityRef",
        "serviceInstanceId",
        "signingKeyRef",
        "requestContractId",
        "operationId",
        "payloadDigest",
        "requestDigest",
        "replySubject",
        "outcome",
        "taskRef",
        "recordRef",
        "sourceRevision",
        "source",
        "recordBytes",
        "replayed",
        "authorityRef",
        "issuedAt",
        "validUntil"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
