{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:orchestration-dispatch",
  "title": "Agentmux orchestration-dispatch v1",
  "description": "A service-owned durable dispatch claim for one admitted orchestration command and frozen effect.",
