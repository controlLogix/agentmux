    "claimRef": { "$ref": "urn:agentmux:contract:1:common#/$defs/reference" },
    "originalOperationId": { "$ref": "urn:agentmux:contract:1:common#/$defs/identifier" },
    "originalPayloadDigest": { "$ref": "urn:agentmux:contract:1:common#/$defs/digest" },
    "candidateDigest": { "$ref": "urn:agentmux:contract:1:common#/$defs/digest" }
  },
  "required": ["resourceRef", "journalRef", "claimRef", "originalOperationId", "originalPayloadDigest", "candidateDigest"]
