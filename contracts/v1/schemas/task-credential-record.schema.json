{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:task-credential-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "credentialRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "generationRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "runRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "planRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "taskRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "workerIdentityRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "consumerRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "destinationRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "workspaceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "networkProfileRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "accountRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "accountIssuerRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "transportRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "identityIssuerRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "taskReadGrantRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "ownerIdentityRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "scope": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/scope"
    },
    "profileId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "authorityId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "attemptId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "readOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "prepareOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "bindingDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "taskApprovalRefs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
      }
    },
    "accountPublicKey": {
      "type": "string",
      "pattern": "^A[A-Z2-7]{55}$"
    },
    "userPublicKey": {
      "type": "string",
      "pattern": "^U[A-Z2-7]{55}$"
    },
    "replySubject": {
      "type": "string",
      "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,64}\\.[A-Za-z0-9_-]{16,64}$"
    },
    "issuedUnix": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresUnix": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "credentialRef",
    "generationRef",
    "runRef",
    "planRef",
    "taskRef",
    "workerIdentityRef",
    "consumerRef",
    "destinationRef",
    "workspaceRef",
    "networkProfileRef",
    "accountRef",
    "accountIssuerRef",
    "transportRef",
    "identityIssuerRef",
    "taskReadGrantRef",
    "ownerIdentityRef",
    "scope",
    "profileId",
    "authorityId",
    "attemptId",
    "readOperationId",
    "prepareOperationId",
    "bindingDigest",
    "policyDigest",
    "taskApprovalRefs",
    "accountPublicKey",
    "userPublicKey",
    "replySubject",
    "issuedUnix",
    "expiresUnix"
  ]
}
