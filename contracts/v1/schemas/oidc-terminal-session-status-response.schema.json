{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:oidc-terminal-session-status-response",
  "title": "Signed terminal OIDC status result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-oidc-terminal-session-status-response-v1"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "issuerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "attemptId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "outcome": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionExpiresAt": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "purpose",
        "hubId",
        "profileId",
        "authorityId",
        "issuerRef",
        "requestDigest",
        "operationId",
        "attemptId",
        "outcome",
        "sessionId",
        "sessionExpiresAt",
        "issuedAt",
        "validUntil"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
