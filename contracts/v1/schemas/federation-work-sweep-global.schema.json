{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:federation-work-sweep-global",
  "title": "federation-work-sweep-global v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "purpose": {
          "const": "hub-lease-sweep"
        },
        "localNode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,32}$"
              },
              "resourceRef": {
                "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
              }
            },
            "required": [
              "repository",
              "resourceRef"
            ]
          }
        }
      },
      "required": [
        "batchId",
        "purpose",
        "localNode",
        "repositories"
      ]
    },
    "attribution": {
      "const": "federation"
    }
  },
  "required": [
    "resourceRef",
    "input",
    "attribution"
  ]
}
