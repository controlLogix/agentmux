      "required": ["purpose", "requestDigest", "configurationRef", "owner", "target", "originalOperationId", "originalPayloadDigest", "desiredPolicyDigest", "authorityRef", "signingKeyRef", "issuedAt", "validUntil"]
    },
    "signature": {"type": "string", "minLength": 1, "maxLength": 128}
