{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:federation-policy-projected-reply",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {"const": "agentmux-federation-policy-projected-v1"},
        "requestDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "configurationRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "owner": {"$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"},
        "target": {"$ref": "urn:agentmux:contract:1:federation-policy-project#/$defs/target"},
        "originalOperationId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "originalPayloadDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "desiredPolicyDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "authorityRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "signingKeyRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
