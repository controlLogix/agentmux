{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:task-credential-state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "agentmux-task-credential-state-v1"
    },
    "record": {
      "$ref": "urn:agentmux:contract:1:task-credential-record"
    },
    "phase": {
      "enum": [
        "prepared",
        "delivery-intent",
        "delivered",
        "uncertain",
        "retired"
      ]
    },
    "resourceRef": {
      "anyOf": [
        {
          "$ref": "urn:agentmux:contract:1:task-credential-container-resource"
        },
        {
          "type": "null"
        }
      ]
    },
    "deliveryOperationId": {
      "anyOf": [
        {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "record",
    "phase",
    "resourceRef",
    "deliveryOperationId"
  ]
}
