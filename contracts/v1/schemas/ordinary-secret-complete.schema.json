{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:ordinary-secret-complete",
  "title": "Agentmux ordinary-secret-complete v1",
  "description": "A custody-service completion bound to an exact retained dispatch and private sanitized physical observation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference",
      "properties": {
        "revision": {
          "const": 1
        }
      }
    },
    "journalRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference",
      "properties": {
        "revision": {
          "minimum": 1
        }
      }
    },
    "claimRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference",
      "properties": {
        "revision": {
          "minimum": 1
        }
      }
    },
    "originalOperationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "originalPayloadDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "enrollmentDigest": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    },
    "observationId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    }
  },
  "required": [
    "resourceRef",
    "journalRef",
    "claimRef",
    "originalOperationId",
    "originalPayloadDigest",
    "enrollmentDigest",
    "observationId"
  ]
}
