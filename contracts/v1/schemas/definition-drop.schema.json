{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:definition-drop",
  "title": "Agentmux definition-drop payload v1",
  "description": "The owner checks the envelope expectedVersion and this exact source checksum against its retained definition revision before deletion. Authentication and current grants require owner checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "definitionId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "scope": {
      "enum": [
        "repo",
        "global"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "expectedChecksum": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
    }
  },
  "required": [
    "definitionId",
    "scope",
    "name",
    "expectedChecksum"
  ]
}
