{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:identity-legacy-alias-resolution",
  "title": "Signed enrolled legacy alias resolution",
  "description": "A short-lived read result bound to the exact request, caller, project scope and retained authority sequence. It is not a reusable authorization grant.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "algorithm": {"const": "Ed25519"},
    "canonicalization": {"const": "RFC8785-JCS-UTF8"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {"const": "agentmux-legacy-alias-resolution-v1"},
        "hubId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "profileId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "authorityId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "issuerRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "requestDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "operationId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "callerRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "scope": {"$ref": "urn:agentmux:contract:1:common#/$defs/scope"},
        "registrations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "urn:agentmux:contract:1:identity-legacy-alias-resolve#/$defs/registration"}
        },
        "remoteAddress": {
          "type": "string",
          "pattern": "^agent:[a-z0-9_]{1,32}-[a-z0-9_]{1,24}-[a-z0-9_]{1,32}$",
          "maxLength": 96
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/binding"}
        },
        "authoritySequence": {"$ref": "urn:agentmux:contract:1:common#/$defs/revision"},
        "issuedAt": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"},
        "validUntil": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"}
      },
      "required": ["purpose", "hubId", "profileId", "authorityId", "issuerRef",
                   "requestDigest", "operationId", "callerRef", "scope",
                   "bindings", "authoritySequence", "issuedAt", "validUntil"],
      "oneOf": [
        {
          "required": ["registrations"],
          "not": {"required": ["remoteAddress"]}
        },
        {
          "required": ["remoteAddress"],
          "not": {"required": ["registrations"]},
          "properties": {
            "bindings": {"minItems": 1, "maxItems": 1}
          }
        }
      ]
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "required": ["schemaVersion", "algorithm", "canonicalization", "claims", "signature"],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alias": {"type": "string", "minLength": 1, "maxLength": 320},
        "canonicalSession": {"type": "string", "minLength": 1, "maxLength": 320},
        "sourceHubId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "registrationGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "identityRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "scope": {"$ref": "urn:agentmux:contract:1:common#/$defs/scope"},
        "instanceOwner": {
          "anyOf": [
            {"$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"},
            {"type": "null"}
          ]
        },
        "aliasRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "authoritySequence": {"$ref": "urn:agentmux:contract:1:common#/$defs/revision"}
      },
      "required": ["alias", "canonicalSession", "sourceHubId", "registrationGeneration",
                   "identityRef", "scope", "instanceOwner", "aliasRef", "authoritySequence"]
    }
  }
}
