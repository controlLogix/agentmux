{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:oidc-terminal-session-open-response",
  "title": "Signed terminal OIDC start result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-oidc-terminal-session-open-response-v1"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "issuerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "attemptId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "userCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "verificationUri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "expiresAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        }
      },
      "required": [
        "purpose",
        "hubId",
        "profileId",
        "authorityId",
        "issuerRef",
        "requestDigest",
        "operationId",
        "attemptId",
        "userCode",
        "verificationUri",
        "interval",
        "expiresAt",
        "issuedAt",
        "validUntil"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
