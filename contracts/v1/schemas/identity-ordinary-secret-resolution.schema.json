{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:identity-ordinary-secret-resolution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-ordinary-secret-resolution-v1"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "issuerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "originalOperationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "originalPayloadDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "originalRequestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "callerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "custodyIdentityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "secretRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "generationRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "consumerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "purposeRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "ownerAudience": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hubId": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
            },
            "serviceId": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
            }
          },
          "required": [
            "hubId",
            "serviceId"
          ],
          "title": "Pinned ordinary secret owner audience"
        },
        "scope": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/scope"
        },
        "authoritySequence": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/revision"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        }
      },
      "required": [
        "purpose",
        "hubId",
        "profileId",
        "authorityId",
        "issuerRef",
        "requestDigest",
        "operationId",
        "originalOperationId",
        "originalPayloadDigest",
        "originalRequestDigest",
        "callerRef",
        "custodyIdentityRef",
        "secretRef",
        "generationRef",
        "consumerRef",
        "purposeRef",
        "ownerAudience",
        "scope",
        "authoritySequence",
        "issuedAt",
        "validUntil"
      ],
      "title": "Verified public ordinary secret bindings"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ],
  "title": "Signed public ordinary secret admission bindings; never secret material"
}
