{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:local-browser-session-response",
  "title": "Signed local browser session result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "algorithm": {"const": "Ed25519"},
    "canonicalization": {"const": "RFC8785-JCS-UTF8"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {"const": "agentmux-local-browser-session-response-v1"},
        "hubId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "profileId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "authorityId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "issuerRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "requestDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "operationId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "challengeDigest": {"$ref": "urn:agentmux:contract:1:common#/$defs/digest"},
        "callerRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "scope": {"$ref": "urn:agentmux:contract:1:common#/$defs/scope"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "lifetimeId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
        "authorityRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        "authoritySequence": {"$ref": "urn:agentmux:contract:1:common#/$defs/revision"},
        "outcome": {"enum": ["approved", "unavailable"]},
        "issuedAt": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"},
        "validUntil": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"}
      },
      "required": ["purpose", "hubId", "profileId", "authorityId", "issuerRef", "requestDigest",
        "operationId", "challengeDigest", "callerRef", "scope", "generation", "lifetimeId",
        "authorityRef", "authoritySequence", "outcome", "issuedAt", "validUntil"]
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "required": ["schemaVersion", "algorithm", "canonicalization", "claims", "signature"]
}
