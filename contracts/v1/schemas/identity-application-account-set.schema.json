{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:identity-application-account-set",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authorityId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
    "record": {"$ref": "urn:agentmux:contract:1:identity-application-account"},
    "previousRef": {
      "anyOf": [
        {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
        {"type": "null"}
      ]
    },
    "administratorCredential": {"$ref": "#/$defs/secretChange"},
    "accountIssuer": {"$ref": "#/$defs/secretChange"}
  },
  "required": ["authorityId", "record", "previousRef", "administratorCredential", "accountIssuer"],
  "$defs": {
    "secretChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {"$ref": "urn:agentmux:contract:1:identity-secret-reference"},
        "previousRef": {
          "anyOf": [
            {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
            {"type": "null"}
          ]
        }
      },
      "required": ["record", "previousRef"]
    }
  },
  "title": "Enroll or rotate an application NATS account",
  "description": "Atomically binds public account metadata to exactly one administrator credential reference and one account issuer reference. The identity owner stores no secret bytes."
}
