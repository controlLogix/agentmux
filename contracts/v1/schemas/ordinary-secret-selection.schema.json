{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/scope"
    },
    "record": {
      "$ref": "urn:agentmux:contract:1:identity-ordinary-secret-reference"
    },
    "pluginIdentityRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "instanceId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "packageId": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
    },
    "custodyRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
    },
    "accountCustodyRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "deployment": {
          "enum": [
            "cloud",
            "server"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "expectedAccount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rootsPEM": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "baseURL",
        "deployment",
        "email",
        "expectedAccount",
        "rootsPEM"
      ]
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
        },
        "connection": {
          "$ref": "urn:agentmux:contract:1:application-service-selection#/$defs/storageConnection"
        },
        "accountPublicKey": {
          "type": "string",
          "pattern": "^A[A-Z2-7]{55}$"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 524288,
              "maximum": 67108864
            },
            "reserveBytes": {
              "type": "integer",
              "minimum": 131072
            },
            "replicas": {
              "enum": [
                1,
                3
              ]
            }
          },
          "required": [
            "maxBytes",
            "reserveBytes",
            "replicas"
          ]
        },
        "maxJournals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 524288,
          "maximum": 4294967296
        },
        "inventoryRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
        },
        "observationRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "namespace",
        "connection",
        "accountPublicKey",
        "retention",
        "maxJournals",
        "maxTotalBytes",
        "inventoryRoot",
        "observationRoot"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transportRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "keyFile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
            },
            "sha256": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "resolveGrant": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "phaseGrants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ordinary-secret-dispatch": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
            },
            "ordinary-secret-complete": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
            }
          },
          "required": [
            "ordinary-secret-dispatch",
            "ordinary-secret-complete"
          ]
        }
      },
      "required": [
        "transportRef",
        "keyFile",
        "publicKey",
        "resolveGrant",
        "phaseGrants"
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "transportRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "grantRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "keyFile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
            },
            "sha256": {
              "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "accountRef",
        "transportRef",
        "grantRef",
        "keyFile",
        "publicKey"
      ]
    },
    "receivers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": {
          "$ref": "urn:agentmux:contract:1:application-service-selection#/$defs/storageReceiver"
        },
        "outcome": {
          "$ref": "urn:agentmux:contract:1:application-service-selection#/$defs/storageReceiver"
        }
      },
      "required": [
        "secret",
        "outcome"
      ]
    }
  },
  "required": [
    "scope",
    "record",
    "pluginIdentityRef",
    "instanceId",
    "packageId",
    "custodyRoot",
    "accountCustodyRoot",
    "consumer",
    "journal",
    "signer",
    "account",
    "receivers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:ordinary-secret-selection",
  "title": "Protected ordinary Secret.Use owner selection"
}
