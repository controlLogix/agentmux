{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Required non-null bytes; reference must equal the requested reference. Enforce decoded and encoded wire limits.",
      "maxLength": 65536,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "resourceRef",
    "data"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:capability-content-reply",
  "title": "capability-content-reply v1"
}
