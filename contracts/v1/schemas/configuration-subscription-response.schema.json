{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:configuration-subscription-response",
  "description": "Configuration-owner signed response. requestDigest hashes the RFC8785 canonical complete signed control wrapper. Cursor fields bind the source and consumer position; event bytes are the unchanged signed producer envelope. joined is true only after original allocation, watcher, request and callback resources settle; an unknown allocation cannot establish a join.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "open",
            "next",
            "close"
          ]
        },
        "requestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$"
        },
        "openRequestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$"
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "approvedEnvelopeDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "filterDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "cursor": {
          "$ref": "urn:agentmux:contract:1:configuration-change-subscribe#/properties/cursor"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "purpose": {
          "const": "agentmux-configuration-subscription-response-v1"
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "authorityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "previousCursor": {
          "$ref": "urn:agentmux:contract:1:configuration-change-subscribe#/properties/cursor"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "outcome": {
          "enum": [
            "opened",
            "event",
            "resync-required",
            "closed"
          ]
        },
        "eventEnvelopeBytes": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "joined": {
          "type": "boolean"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "replySubject": {
          "type": "string",
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,64}\\.[a-f0-9]{64}$",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f\u2028\u2029]"
          }
        }
      },
      "required": [
        "action",
        "requestId",
        "openRequestId",
        "leaseId",
        "owner",
        "operationId",
        "approvedEnvelopeDigest",
        "filterDigest",
        "cursor",
        "signingKeyRef",
        "issuedAt",
        "purpose",
        "requestDigest",
        "authorityRef",
        "previousCursor",
        "validUntil",
        "outcome",
        "profileId",
        "hubId",
        "authorityId",
        "replySubject"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "opened"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "open"
              },
              "leaseId": {
                "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "joined"
                  ]
                },
                {
                  "required": [
                    "eventEnvelopeBytes"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "eventEnvelopeBytes"
            ],
            "properties": {
              "action": {
                "const": "next"
              },
              "leaseId": {
                "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
              }
            },
            "not": {
              "required": [
                "joined"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "resync-required"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "open",
                  "next"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "joined"
                  ]
                },
                {
                  "required": [
                    "eventEnvelopeBytes"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "closed"
              }
            }
          },
          "then": {
            "required": [
              "joined"
            ],
            "properties": {
              "action": {
                "const": "close"
              }
            },
            "not": {
              "required": [
                "eventEnvelopeBytes"
              ]
            }
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
