{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:application-binding-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "agentmux-application-binding-response-v1"
        },
        "requestId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "instanceId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "releaseDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "policyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "workspaceRef": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "scope": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/scope"
        },
        "transportRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "callerRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "grantRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "authorityRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "authoritySequence": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/revision"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifetimeId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "purpose",
        "requestId",
        "nonce",
        "authorityId",
        "hubId",
        "profileId",
        "instanceId",
        "releaseDigest",
        "policyRef",
        "workspaceRef",
        "requestDigest",
        "scope",
        "transportRef",
        "callerRef",
        "grantRef",
        "signingKeyRef",
        "authorityRef",
        "authoritySequence",
        "issuedAt",
        "validUntil",
        "generation",
        "lifetimeId"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
