{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:federation-work-register",
  "title": "federation-work-register v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceRef": {
      "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "purpose": {
          "const": "hub-registration"
        },
        "localNode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,32}$"
              },
              "resourceRef": {
                "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
              }
            },
            "required": [
              "repository",
              "resourceRef"
            ]
          }
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "type": "string",
          "maxLength": 32
        },
        "role": {
          "type": "string",
          "maxLength": 64
        },
        "agent": {
          "type": "string",
          "maxLength": 64
        },
        "cli": {
          "type": "string",
          "maxLength": 128
        },
        "roleSnapshot": {
          "type": "object"
        },
        "transport": {
          "type": "string",
          "maxLength": 128
        },
        "handle": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "panePid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "batchId",
        "purpose",
        "localNode",
        "repositories",
        "generation",
        "repo",
        "role",
        "agent",
        "cli",
        "roleSnapshot",
        "transport",
        "handle",
        "panePid",
        "legacy",
        "tokenSha"
      ]
    },
    "attribution": {
      "const": "federation"
    }
  },
  "required": [
    "resourceRef",
    "input",
    "attribution"
  ]
}
