{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:identity-secret-reference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ref": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
    "kind": {"enum": ["nats-administrator-credential", "nats-account-issuer"]},
    "scope": {"$ref": "urn:agentmux:contract:1:common#/$defs/scope"},
    "profileId": {"$ref": "urn:agentmux:contract:1:common#/$defs/identifier"},
    "ownerIdentityRef": {"$ref": "urn:agentmux:contract:1:common#/$defs/reference"},
    "status": {"enum": ["active", "revoked"]},
    "issuedAt": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"},
    "expiresAt": {"$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"}
  },
  "required": ["ref", "kind", "scope", "profileId", "ownerIdentityRef", "status", "issuedAt", "expiresAt"],
  "title": "Public identity-owner metadata for an owner-custodied secret",
  "description": "Contains references and public bindings only. Secret bytes and storage locations never enter identity state."
}
