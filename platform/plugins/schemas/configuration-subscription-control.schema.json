{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:configuration-subscription-control",
  "description": "Host-signed control of one original configuration subscription. openRequestId identifies the original allocation even when its reply is lost. next requires current original subscription authority; close only cancels and joins that exact allocation. It grants no business authority and is not an ordinary operation envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "RFC8785-JCS-UTF8"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "open",
            "next",
            "close"
          ]
        },
        "requestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$"
        },
        "openRequestId": {
          "type": "string",
          "pattern": "^request_[a-f0-9]{64}$"
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "$ref": "urn:agentmux:contract:1:ordinary-plugin-lifecycle#/$defs/owner"
        },
        "operationId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "approvedEnvelopeDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "filterDigest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "cursor": {
          "$ref": "urn:agentmux:contract:1:configuration-change-subscribe#/properties/cursor"
        },
        "signingKeyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "issuedAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "purpose": {
          "const": "agentmux-configuration-subscription-control-v1"
        },
        "expiresAt": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/timestamp"
        },
        "subscriptionEnvelopeBytes": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "profileId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "hubId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
        },
        "replySubject": {
          "type": "string",
          "pattern": "^_INBOX\\.[A-Za-z0-9_-]{16,64}\\.[a-f0-9]{64}$",
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f\u2028\u2029]"
          }
        }
      },
      "required": [
        "action",
        "requestId",
        "openRequestId",
        "leaseId",
        "owner",
        "operationId",
        "approvedEnvelopeDigest",
        "filterDigest",
        "cursor",
        "signingKeyRef",
        "issuedAt",
        "purpose",
        "expiresAt",
        "profileId",
        "hubId",
        "authorityId",
        "replySubject"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "open"
              }
            }
          },
          "then": {
            "required": [
              "subscriptionEnvelopeBytes"
            ],
            "properties": {
              "leaseId": {
                "type": "null"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "subscriptionEnvelopeBytes"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "next"
              }
            }
          },
          "then": {
            "properties": {
              "leaseId": {
                "$ref": "urn:agentmux:contract:1:common#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "canonicalization",
    "claims",
    "signature"
  ]
}
