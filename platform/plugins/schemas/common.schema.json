{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentmux:contract:1:common",
  "title": "Agentmux common v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "ownerHubId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "ownerHubId",
        "revision"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organizationId",
        "projectId",
        "workspaceId"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "apiMajor": {
          "type": "integer",
          "minimum": 1
        },
        "scopeRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "handleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "transport": {
          "const": "nats"
        }
      },
      "required": [
        "interfaceId",
        "apiMajor",
        "scopeRef",
        "handleId",
        "transport"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "enum": [
            "linux",
            "darwin"
          ]
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "ownerHubId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "storeRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "digest": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "artifactId",
        "ownerHubId",
        "storeRef",
        "version",
        "digest",
        "bytes",
        "mediaType"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "issuerHubId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "subjectInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "scope": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/scope"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "Explicit resource IDs only. An empty array grants no resource access; it is never a wildcard."
        },
        "issuedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "policyRef": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
        },
        "parentGrantRef": {
          "anyOf": [
            {
              "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "$ref": "urn:agentmux:contract:1:common#/$defs/revision"
        }
      },
      "required": [
        "grantId",
        "issuerHubId",
        "subjectInstanceId",
        "scope",
        "actions",
        "resourceIds",
        "issuedAt",
        "expiresAt",
        "policyRef",
        "parentGrantRef",
        "revision"
      ]
    }
  },
  "description": " Executable P01 contract. Runtime enrollment, authorization and durable ownership remain separate obligations."
}
