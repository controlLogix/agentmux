                    "$ref": "urn:agentmux:contract:1:operation-context"
                  },
                  "operationAuthorityRef": {
                    "$ref": "urn:agentmux:contract:1:common#/$defs/reference"
                  },
                  "originalEnvelopeBytes": {
                    "type": "string",
                    "maxLength": 87384,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  },
                  "subscriptionEnvelopeBytes": {
                    "type": "string",
                    "maxLength": 87384,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
